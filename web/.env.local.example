# Copy to .env.local for local testing. NEVER commit .env.local.
# On Vercel, add these under Settings -> Environment Variables instead.

GROQ_API_KEY=gsk_your_server_key_here
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key_here

# Optional overrides (defaults shown)
# CHAT_MODEL=openai/gpt-oss-120b
# VOICE_MODEL=whisper-large-v3
# CHAT_PER_DAY=30
# VOICE_PER_DAY=20
# GLOBAL_CHAT_PER_DAY=3000
# GLOBAL_VOICE_PER_DAY=1500
# PER_MINUTE=5
# MAX_INPUT_CHARS=40000
# MAX_COMPLETION_TOKENS=3000
# MAX_AUDIO_BYTES=3000000
# MIN_ACCOUNT_AGE_DAYS=7
# REASONING_EFFORT=low
